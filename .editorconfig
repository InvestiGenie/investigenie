root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{rs,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[backend/migrations/**]
# Applied migrations are checksummed; never reformat them.
insert_final_newline = unset
trim_trailing_whitespace = unset

[Makefile]
indent_style = tab
