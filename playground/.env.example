# Copy to playground/.env to change defaults. Shell variables override this file.
# After changing seeding settings, run `./playground/playground.sh reseed`.

# ---- Seeded corpus (Elasticsearch index pattern investigenie-logs-*, data view "playground-logs")
PLAYGROUND_EVENTS=50000          # baseline events (incidents add ~7k more)
PLAYGROUND_DAYS=7                # history length; the oldest incident needs >= 3 days
PLAYGROUND_SEED=731              # same seed => same corpus
PLAYGROUND_SCENARIOS=all         # all | none | comma list, e.g. checkout-bad-deploy,identity-credential-stuffing
PLAYGROUND_LIVE_EPS=2            # live events per second after seeding (0 = off)
PLAYGROUND_LIVE_INCIDENT=true    # keep the "gateway-search-timeouts" incident running live
PLAYGROUND_LIVE_RETENTION_DAYS=3 # delete live-only daily indices older than this (seeded history is kept; 0 = never)

# ---- ClickHouse: the official public playground (read-only, needs internet access from Docker)
PLAYGROUND_CLICKHOUSE=play       # play | off
PLAYGROUND_CLICKHOUSE_URL=https://play.clickhouse.com:443
PLAYGROUND_CLICKHOUSE_USER=explorer
PLAYGROUND_CLICKHOUSE_PASSWORD=
PLAYGROUND_CLICKHOUSE_DATABASE=default
PLAYGROUND_CLICKHOUSE_DATA_VIEWS=github_events:created_at,hackernews:time   # table:time_field,...

# ---- AI models (registered in InvestiGenie; pick one per investigation in the AI page)
PLAYGROUND_AI_PROVIDER=ollama    # ollama | openai-compatible | none
PLAYGROUND_AI_MODELS=qwen2.5:7b  # comma list of Ollama tags, e.g. qwen2.5:7b,qwen2.5:3b,llama3.2:3b
PLAYGROUND_AI_CONTEXT=16384      # Ollama context window (num_ctx) for the tuned investigenie/<model> copies
PLAYGROUND_AI_TEMPERATURE=0.1
# Set by `playground.sh up --ai docker|host`; override for a remote Ollama.
# PLAYGROUND_OLLAMA_URL=http://ollama:11434
# For vLLM, LM Studio, llama.cpp server, or a hosted API (PLAYGROUND_AI_PROVIDER=openai-compatible).
# The URL must be reachable from the investigenie container (use host.docker.internal for the host).
PLAYGROUND_AI_API_URL=
PLAYGROUND_AI_API_KEY=

# Save-time model probe timeout in InvestiGenie (default 15s outside the playground).
AI_PROBE_TIMEOUT_SECONDS=120
# Keep models loaded in the Ollama container between investigations.
OLLAMA_KEEP_ALIVE=24h

# ---- Misc
ES_HEAP=512m
INVESTIGENIE_PORT=3000
