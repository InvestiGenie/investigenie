RUST_API_BIND=127.0.0.1:3000
WEB_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:3000

# database (production HA) or filesystem (single instance)
PERSISTENCE_MODE=filesystem
# Required only for database mode. Supply credentials privately.
DATABASE_URL=
DB_MAX_CONNECTIONS=10
# Required only for filesystem mode. Relative to the API working directory.
FILESYSTEM_PATH=./northstar_data
# Required in both modes: base64-encoded 32 random bytes. Keep across restarts.
CONFIG_ENCRYPTION_KEY=
CONFIG_ENCRYPTION_KEY_ID=v1